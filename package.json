{
  "name": "easy-music",
  "version": "0.1.2",
  "private": true,
  "license": "MIT",
  "author": "yilaixiaohei",
  "repository": {
    "type": "git",
    "url": "https://github.com/yilaixiaohei/easy-music.git"
  },
  "homepage": "https://github.com/yilaixiaohei/easy-music#readme",
  "bugs": { "url": "https://github.com/yilaixiaohei/easy-music/issues" },
  "description": "A simple personal desktop music client",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "build": "npm run typecheck && electron-vite build",
    "package:zip": "npm run build && node scripts/package-zip.cjs",
    "package:installer": "npm run build && node scripts/package-installer.cjs",
    "build:icons": "electron scripts/generate-icons.cjs",
    "preview": "electron-vite preview",
    "postinstall": "install-electron",
    "test": "tsx --test tests/*.test.ts",
    "check:auth": "electron scripts/smoke-auth.cjs",
    "check:music": "electron scripts/smoke-music.cjs",
    "check:tray": "electron scripts/smoke-tray.cjs",
    "check:instance": "node scripts/smoke-single-instance.cjs",
    "check:cover": "electron scripts/smoke-cover.cjs"
  },
  "dependencies": {
    "@lucide/vue": "^1.57.0",
    "@neteasecloudmusicapienhanced/api": "4.41.1",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "electron": "^44.7.2",
    "electron-builder": "26.15.3",
    "electron-vite": "^6.0.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vue-tsc": "^3.3.13"
  },
  "engines": {
    "node": ">=24"
  }
}
